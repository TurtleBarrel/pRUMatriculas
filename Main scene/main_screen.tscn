[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Window




func _on_big_pressed() -> void:
	get_tree().root.content_scale_factor += 0.2


func _on_small_pressed() -> void:
	get_tree().root.content_scale_factor -= 0.2


func _on_file_path_1_pressed() -> void:
	var diag = FileDialog.new()
	diag.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	diag.access = FileDialog.ACCESS_FILESYSTEM
	diag.force_native = true
	diag.use_native_dialog = true
	diag.root_subfolder = OS.get_system_dir(OS.SYSTEM_DIR_DOWNLOADS)
	#diag.root_subfolder = OS.get_user_data_dir()
	GlobalScene.add_child(diag)
	diag.popup_centered()
	
	diag.close_requested.connect(diag.queue_free)
"

